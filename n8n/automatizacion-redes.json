            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "pasar",
              "leftValue": "={{ $('Pedir respuesta al asistente').item.json.pasar_a_asesor }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pasar-asesor",
      "name": "¿Pasar a un asesor?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1680,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://CAMBIAR-chatwoot/api/v1/accounts/{{ $('Datos del cliente').item.json.cuenta_chatwoot }}/conversations/{{ $('Datos del cliente').item.json.conversacion }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: 'Pasa a asesor' + ($('Pedir respuesta al asistente').item.json.motivo ? ': ' + $('Pedir respuesta al asistente').item.json.motivo : '') + '\\n\\n' + ($('Pedir respuesta al asistente').item.json.resumen_para_asesor || ''), message_type: 'outgoing', private: true }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "nota-privada",
      "name": "Nota privada para el asesor",
