      "typeVersion": 2,
      "position": [
        1200,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://CAMBIAR-chatwoot/api/v1/accounts/{{ $('Datos del cliente').item.json.cuenta_chatwoot }}/conversations/{{ $('Datos del cliente').item.json.conversacion }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.respuesta, message_type: 'outgoing', private: false }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "responder-chatwoot",
      "name": "Responder en Chatwoot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
